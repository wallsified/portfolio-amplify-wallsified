---
import "@fontsource-variable/fraunces";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";

import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import SideRails from "../components/SideRails.astro";
import { getDict, getPath, type Locale, type PageKey } from "../i18n";
import { config } from "../config";

// Shared shell for every page: SEO head (canonical, hreflang, OG/Twitter,
// JSON-LD), skip link, nav, side rails, footer and the page slot.
interface Props {
  locale: Locale;
  pageKey: PageKey;
  profile: {
    name: string;
    handle: string;
    title: string;
    email: string;
    avatar: string;
    links: { github: string; linkedin: string; aws: string; cv: string };
  };
}

const { locale, pageKey, profile } = Astro.props;
const dict = getDict(locale);
const meta = dict.meta[pageKey];

const site = Astro.site; // https://wallsified.dev
// The static build emits directory URLs (`/experiencia/`), so canonical and
// hreflang use the same trailing-slash form the sitemap generates.
const withSlash = (path: string) => (path === "/" || path.endsWith("/") ? path : `${path}/`);
const canonicalPath = withSlash(getPath(locale, pageKey));
const canonical = new URL(canonicalPath, site);

const esUrl = new URL(withSlash(getPath("es", pageKey)), site);
const enUrl = new URL(withSlash(getPath("en", pageKey)), site);
const xDefaultUrl = esUrl; // Spanish is the default locale

const otherLocale: Locale = locale === "es" ? "en" : "es";

const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  alternateName: profile.handle,
  jobTitle: profile.title,
  url: canonical.href,
  sameAs: [profile.links.github, profile.links.linkedin, profile.links.aws],
};

const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: profile.name,
  url: new URL("/", site).href,
  inLanguage: ["es", "en"],
};

const ogImage = new URL("/images/og.png", site);
---

<!doctype html>
<html lang={dict.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    {/* English stays out of search until the owner approves it. */}
    {locale === "en" && !config.englishReviewed && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="es" href={esUrl.href} />
    <link rel="alternate" hreflang="en" href={enUrl.href} />
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl.href} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={dict.ogLocale} />
    <meta property="og:locale:alternate" content={getDict(otherLocale).ogLocale} />
    <meta property="og:site_name" content={profile.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={ogImage.href} />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-sm focus:bg-surface-secondary focus:px-4 focus:py-3 focus:font-mono focus:text-sm focus:text-accent"
    >
      {dict.skipToContent}
    </a>

    <Nav locale={locale} pageKey={pageKey} cvHref={profile.links.cv} />
    <SideRails locale={locale} links={profile.links} />

    <main id="main" class="min-h-[60vh] px-5 pt-[136px] pb-16 sm:px-6 min-[1080px]:pt-[172px] min-[1080px]:pb-[100px]">
      <div class="mx-auto max-w-[1000px]">
        <slot />
      </div>
    </main>

    <Footer locale={locale} email={profile.email} name={profile.name} links={profile.links} />
  </body>
</html>
