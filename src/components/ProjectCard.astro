---
import Icon from "./Icon.astro";
import type { getSorted } from "../lib/content";

// Project card (DESIGN.md §4): surface-secondary, 8px radius, 28px padding,
// folder icon in accent, title, 3-line description, mono tech list;
// hover translateY(-4px) via .lift.
type ProjectEntry = Awaited<ReturnType<typeof getSorted<"projects">>>[number];

interface Props {
  entry: ProjectEntry;
}

const { entry } = Astro.props;
const { title, description, tech, url } = entry.data;
---

<article class="lift rounded-md bg-surface-secondary p-7">
  <div class="flex items-start justify-between gap-4">
    <h3 class="text-[19px] leading-snug">
      <a href={url} rel="noopener" class="transition-colors duration-fast hover:text-accent">
        {title}
      </a>
    </h3>
    <Icon name="folder" size={24} class="shrink-0 text-accent" />
  </div>
  <p class="mt-3 line-clamp-3 text-[15px] leading-relaxed text-text-secondary">{description}</p>
  <ul class="mt-5 flex flex-wrap gap-x-4 gap-y-1 font-mono text-[13px] text-text-secondary">
    {tech.map((item) => <li>{item}</li>)}
  </ul>
</article>
