---
import type { Locale, PageKey } from "../i18n";
import { buildNotionPayload } from "../lib/notion";

// Hidden Notion Mode. This component only ships
// the current page digest as JSON plus a tiny trigger; the window itself is a
// lazy module imported on first use, so it costs nothing on initial load.
interface Props {
  locale: Locale;
  pageKey: PageKey;
  profile: {
    name: string;
    title: string;
    location: string;
    greeting: string;
    bio: string;
  };
}

const { locale, pageKey, profile } = Astro.props;
const payload = await buildNotionPayload(locale, pageKey, profile);
// Escape "<" so content can never close the script tag.
const json = JSON.stringify(payload).replace(/</g, "\\u003c");
---

<script type="application/json" data-notion-payload set:html={json}></script>

<script>
  import type { NotionPayload } from "../lib/notion";

  // Tiny trigger; the window module is imported on first use only.
  const payloadEl = document.querySelector<HTMLScriptElement>(
    "script[data-notion-payload]",
  );
  const payload: NotionPayload | null = payloadEl?.textContent
    ? (JSON.parse(payloadEl.textContent) as NotionPayload)
    : null;

  let mod: typeof import("../scripts/notion-window") | null = null;
  let loading = false;

  async function open(trigger: HTMLElement | null): Promise<void> {
    if (!payload || loading) return;
    if (!mod) {
      loading = true;
      try {
        mod = await import("../scripts/notion-window");
      } catch {
        mod = null;
        return;
      } finally {
        loading = false;
      }
    }
    mod?.showNotion(payload, trigger);
  }

  // Trigger: the `n` key, passive, never preventDefault, never while typing
  // in a field and never with modifiers (DESIGN.md §10).
  document.addEventListener(
    "keydown",
    (e) => {
      if (e.key.toLowerCase() !== "n") return;
      if (e.metaKey || e.ctrlKey || e.altKey || e.isComposing) return;
      const target = e.target;
      if (
        target instanceof HTMLElement &&
        (target.tagName === "INPUT" ||
          target.tagName === "TEXTAREA" ||
          target.tagName === "SELECT" ||
          target.isContentEditable)
      )
        return;
      void open(
        document.activeElement instanceof HTMLElement ? document.activeElement : null,
      );
    },
    { passive: true },
  );

  // The small hint icon in the side rail (≥1080px) also opens the window.
  document.querySelectorAll<HTMLElement>("[data-notion-open]").forEach((button) => {
    button.addEventListener("click", () => void open(button));
  });

  // A single console hint for whoever happens to be looking at devtools.
  if (payload) console.log(payload.ui.consoleHint);
</script>
