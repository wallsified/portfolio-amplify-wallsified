---
import { getDict, type Locale } from "../i18n";

// Footer on every page (DESIGN.md §5): a contact band (serif H3, one
// sentence, outline mailto button), then © year (build-time) and social links.
interface Props {
  locale: Locale;
  email: string;
  name: string;
  links: { github: string; linkedin: string; aws: string; cv: string };
}

const { locale, email, name, links } = Astro.props;
const dict = getDict(locale);
const year = new Date().getFullYear();

const socials = [
  { href: links.github, label: "GitHub" },
  { href: links.linkedin, label: "LinkedIn" },
  { href: links.aws, label: dict.socialLabels.aws },
  { href: links.cv, label: dict.cvLabel }
];
---

<footer class="mt-16 border-t border-line md:mt-20">
  <!-- Contact band (compact: the footer closes the page, it is not a hero) -->
  <div class="mx-auto max-w-250 px-5 py-10 text-center sm:px-6 md:py-14">
    <h3 class="text-[clamp(22px,2.5vw,26px)]">{dict.footer.heading}</h3>
    <p class="mx-auto mt-2 max-w-[46ch] text-[15px] text-text-secondary">{dict.footer.text}</p>
    <a href={`mailto:${email}`} class="btn-outline mt-6">{dict.footer.cta}</a>
  </div>

  <!-- © year and links. Socials live in the side rails on wide screens,
       so they only appear here when the rails are hidden (<1080px). -->
  <div class="border-t border-line px-5 py-6 sm:px-6">
    <div
      class="mx-auto flex max-w-250 flex-col items-center gap-4 sm:flex-row sm:justify-between"
    >
      <p class="font-mono text-xs text-text-secondary">© {year} {name}</p>
      <ul class="flex items-center gap-5 min-[1080px]:hidden">
        {
          socials.map((social) => (
            <li>
              <a
                href={social.href}
                class="flex h-11 items-center font-mono text-xs text-text-secondary transition-colors duration-fast hover:text-accent"
                rel="noopener"
              >
                {social.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
