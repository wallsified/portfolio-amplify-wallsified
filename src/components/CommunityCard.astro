---
import type { getSorted } from "../lib/content";


type CommunityEntry = Awaited<ReturnType<typeof getSorted<"communities">>>[number];

interface Props {
  entry: CommunityEntry;
  /** Prefix for the card id inside the builder tree (avoids duplicate ids). */
  idPrefix?: string;
}

const { entry, idPrefix = "" } = Astro.props;
const { name, role, description, url, emoji } = entry.data;

// Pastel wash rotation for the emoji circles (peach, sage, sky).
const washes = ["bg-wash-peach", "bg-wash-sage", "bg-wash-sky"] as const;
const wash = washes[entry.data.order % washes.length] ?? "bg-wash-sage";
---

<a
  href={url}
  rel="noopener"
  data-card
  class="lift flex flex-col rounded-md border border-line bg-surface-secondary p-8 hover:border-accent/40"
  id={`${idPrefix}${entry.id}`}
>
  <span
    class:list={[
      "grid h-12 w-12 place-items-center rounded-full text-[32px] leading-none",
      wash,
    ]}
    aria-hidden="true">{emoji}</span>
  <h3 class="mt-5 text-[22px] leading-snug">{name}</h3>
  <p class="mt-2 text-[15px] leading-relaxed text-text-secondary">{description}</p>
  <p class="mt-4 font-mono text-xs text-accent" data-chip="purple">{role}</p>
</a>
