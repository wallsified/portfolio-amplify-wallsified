---
import Icon from "./Icon.astro";
import type { getSorted } from "../lib/content";

// Featured project row (DESIGN.md §4): alternating image/text rows. Image has
// an accent-wash tint (30%) that fades on hover; the description card overlaps
// the image by 40px; tech list in mono 13px text-secondary, then GitHub icon.
type ProjectEntry = Awaited<ReturnType<typeof getSorted<"projects">>>[number];

interface Props {
  entry: ProjectEntry;
  flip?: boolean;
}

const { entry, flip = false } = Astro.props;
const { title, description, tech, url, image } = entry.data;
---

<article class="relative grid items-center gap-6 md:grid-cols-2 md:gap-0">
  <!-- Image with accent-wash tint that fades on hover -->
  <div class:list={["group relative", flip && "md:order-2"]}>
    <img
      src={image?.src}
      alt={image?.alt}
      width="1200"
      height="750"
      loading="lazy"
      decoding="async"
      class="aspect-[16/10] w-full rounded-sm object-cover"
    />
    <span
      class="pointer-events-none absolute inset-0 rounded-sm bg-accent opacity-30 transition-opacity duration-base group-hover:opacity-0"
      aria-hidden="true"></span>
  </div>

  <!-- Description card overlapping the image by 40px -->
  <div
    class:list={[
      "relative z-10 rounded-sm bg-surface-secondary p-7",
      flip ? "md:-ml-10" : "md:-mr-10",
    ]}
  >
    <h3 class="text-[22px] leading-snug">
      <a href={url} rel="noopener" class="transition-colors duration-fast hover:text-accent">
        {title}
      </a>
    </h3>
    <p class="mt-3 max-w-[52ch] text-[15px] leading-relaxed text-text-secondary">{description}</p>
    <div class="mt-5 flex flex-wrap items-center justify-between gap-4">
      <ul class="flex flex-wrap gap-x-4 gap-y-1 font-mono text-[13px] text-text-secondary">
        {tech.map((item) => <li>{item}</li>)}
      </ul>
      <a
        href={url}
        aria-label={`${title} — GitHub`}
        rel="noopener"
        class="flex h-11 w-11 items-center justify-center text-text-secondary transition-colors duration-fast hover:text-accent"
      >
        <Icon name="github" size={20} />
      </a>
    </div>
  </div>
</article>
