---
import Icon from "./Icon.astro";
import { getDict, type Locale } from "../i18n";
import type { getSorted } from "../lib/content";

// Material row (DESIGN.md §4): grid auto 1fr auto, 20px vertical padding,
// bottom border 1px line. Left: mono type tag. Center: title + one-line
// description. Right: mono host or year, then external-link arrow.
// Hover: title turns accent. The whole row is a real link with rel="noopener".
type MaterialEntry = Awaited<ReturnType<typeof getSorted<"materials">>>[number];

interface Props {
  locale: Locale;
  entry: MaterialEntry;
}

const { locale, entry } = Astro.props;
const dict = getDict(locale);
const { title, description, url, type, inSpanish } = entry.data;
const host = new URL(url).hostname.replace(/^www\./, "");
---

<a
  href={url}
  rel="noopener"
  class="group grid grid-cols-[auto_1fr_auto] items-baseline gap-x-4 gap-y-1 border-b border-line py-5"
>
  <span class="font-mono text-xs text-accent">{dict.materialTypes[type]}</span>
  <span class="min-w-0">
    <span class="block truncate text-[17px] text-text-primary transition-colors duration-fast group-hover:text-accent">
      {title}
    </span>
    <span class="mt-0.5 block truncate text-[15px] text-text-secondary">{description}</span>
    {inSpanish && <span class="mt-1 block font-mono text-xs text-text-secondary">({dict.inSpanish})</span>}
  </span>
  <span class="flex items-center gap-2 font-mono text-xs text-text-secondary">
    <span>{host}</span>
    <Icon name="external" size={14} class="transition-colors duration-fast group-hover:text-accent" />
  </span>
</a>
